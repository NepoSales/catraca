{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node", "jest"],
    // O NestJS descobre as dependências de cada classe pelos tipos do construtor.
    // Essas duas opções fazem o TypeScript guardar esses tipos no JavaScript gerado.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src"]
}
